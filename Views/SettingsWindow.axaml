<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KeiLauncher.ViewModels"
        x:Class="KeiLauncher.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Title="{Binding Title}"
        Icon="/Assets/Icon/kei_halo.ico"
        Width="430" Height="510"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0a0f18">

    <Grid RowDefinitions="Auto, *, Auto" Margin="24,20,24,20">

        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Image Source="/Assets/Icon/kei.ico" Width="26" Height="26" VerticalAlignment="Center" />
                <TextBlock Text="KEI LAUNCHER"
                           FontSize="18" FontWeight="Black"
                           Foreground="White"
                           LetterSpacing="1.2"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Border Background="#102035"
                        BorderBrush="#0284c7"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,2">
                    <TextBlock Text="// SYSTEM PREFERENCES"
                               FontSize="11" FontWeight="Bold"
                               Foreground="#38bdf8" />
                </Border>
                <TextBlock Text="{Binding VersionLabel}"
                           FontSize="12" Foreground="#94a3b8"
                           VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- Settings Options Card -->
        <Border Grid.Row="1" Classes="cyber-card" VerticalAlignment="Top">
            <StackPanel Spacing="16">

                <CheckBox Content="{Binding CloseOnLaunchLabel}"
                          IsChecked="{Binding CloseOnLaunch}"
                          Foreground="#e2e8f0"
                          FontSize="13" />

                <CheckBox Content="{Binding CheckUpdateOnLaunchLabel}"
                          IsChecked="{Binding CheckUpdateOnLaunch}"
                          Foreground="#e2e8f0"
                          FontSize="13" />

                <CheckBox Content="{Binding DownloadGraphicBundlesLabel}"
                          IsChecked="{Binding DownloadGraphicBundles}"
                          Foreground="#e2e8f0"
                          FontSize="13" />

                <Border Height="1" Background="#1e324d" Margin="0,2,0,2" />

                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="◈" Foreground="#38bdf8" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LanguageLabel}"
                                   Foreground="#e2e8f0" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding LanguageOptions}"
                              SelectedItem="{Binding SelectedLanguageDisplay}"
                              Width="140" Height="34"
                              FontSize="13" />
                </Grid>

            </StackPanel>
        </Border>

        <!-- Footer / Action Buttons & Status -->
        <StackPanel Grid.Row="2" Spacing="12" Margin="0,16,0,0" HorizontalAlignment="Center">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{Binding StatusColor}"
                       FontSize="13" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <Button Classes="cyber-btn tech"
                        Content="{Binding GithubRepoLabel}"
                        Width="160" Height="38"
                        Command="{Binding OpenGithubCommand}" />

                <Button Classes="cyber-btn blue"
                        Content="{Binding CheckUpdateLabel}"
                        Width="160" Height="38"
                        Command="{Binding CheckLauncherUpdateCommand}" />
            </StackPanel>
        </StackPanel>

    </Grid>
</Window>
